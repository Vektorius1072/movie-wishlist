# Postgres. Для локальной разработки и для продакшена можно использовать
# один и тот же бесплатный сервис — Neon (neon.tech).
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"

# Бесплатный ключ: https://www.themoviedb.org/settings/api
TMDB_API_KEY="your_tmdb_api_key_here"

# Базовый адрес приложения
APP_URL="http://localhost:3000"

# Resend (resend.com) — отправка писем подтверждения почты.
# Если оставить пустым — ссылка подтверждения печатается в консоль сервера.
RESEND_API_KEY=""
MAIL_FROM=""

# Upstash Redis (upstash.com) — rate limiting на регистрации/входе/поиске.
# Если оставить пустым — rate limiting просто отключается.
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""
